generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model File {
  id   String @id @default(uuid())
  path String
  user User?

  @@map("file")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String?   @unique(map: "UQ_e12875dfb3b1d92d7d7c5377e22")
  emailVerified Boolean   @default(false)
  password      String?
  provider      String    @default("email")
  role          String    @default("user")
  socialId      String?
  firstName     String?
  lastName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?
  photoId       String?   @unique(map: "REL_75e2be4ce11d447ef43be0e374")
  photo         File?     @relation(fields: [photoId], references: [id])
  sessions      Session[]

  @@index([socialId], map: "IDX_9bd2fe7a8e694dedc4ec2f666f")
  @@index([firstName], map: "IDX_58e4dbff0e1a32a9bdc861bb29")
  @@index([lastName], map: "IDX_f0e1b4ecdca13b177e2e3a0613")
  @@map("user")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int?
  hash      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId], map: "IDX_3d2f174ef04fb312fdebd0ddc5")
  @@map("session")
}
